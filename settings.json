{
  "show_logo": true,
  "concurrency": {
    "channels": 3,
    "retries": 2,
    "retry_delay": 5
  },
  "ydl_opt": {
    "quiet": true,
    "no_warnings": true,
    "extract_flat": true,
    "skip_download": true,
    "sleep_interval": 1,
    "max_sleep_interval": 2,
    "sleep_requests": 1
  },
  "saving": {
    "fields": [
      "uploader_id", "channel_id", "uploader", "channel_url", "channel_follower_count",
      "channel_is_verified", "creators", "uploader_url", "id", "title", "thumbnail",
      "view_count", "like_count", "comment_count", "upload_date", "language", "availability",
      "duration", "average_rating", "age_limit", "categories", "tags", "live_status",
      "was_live", "is_live", "format", "aspect_ratio", "resolution", "abr", "vbr",
      "ext", "tbr", "asr", "audio_ext", "video_ext", "protocol", "dynamic_range",
      "acodec", "vcodec", "filesize_approx", "format_note", "audio_channels",
      "width", "height", "fps", "release_year", "filesize", "format_id", "epoch",
      "duration_string", "fulltitle", "display_id", "playlist_index", "extractor",
      "timestamp", "extractor_key", "release_timestamp", "channel", "media_type",
      "playable_in_embed", "original_url", "webpage_url", "webpage_url_basename",
      "webpage_url_domain"
    ]
  },
  "raw": {
    "save_raw": true
  },
  "logging": {
    "save_log": true
  },
  "json": {
    "save_json": true,
    "indent": 2
  },
  "csv": {
    "save_csv": true
  }
}
